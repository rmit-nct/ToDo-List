# Copy to .env.local at the repository root. Obtain credentials privately from the database owner.
# Replace placeholders; URL-encode special characters in the username/password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@neo-todo-cluster.qlhhwwe.mongodb.net/neo_todo?authSource=admin&retryWrites=true&w=majority&appName=NEO-Todo-Cluster
MONGODB_DB=neo_todo
APP_ORIGINS=http://localhost:3000,http://localhost:5173
NEXTAUTH_URL=http://localhost:3000
# Generate each value separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
SETTINGS_ENCRYPTION_KEY=
