# Leave empty for the automatic local development database.
MONGODB_URI=
PORT=5001
# Exact frontend origins, comma separated. Add your deployed HTTPS origin.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174
# Production: 64 hex characters from crypto.randomBytes(32).toString('hex').
# Local development creates an ignored .settings-key file automatically.
SETTINGS_ENCRYPTION_KEY=
# Optional isolated local database directory (inside backend).
LOCAL_DB_DIRECTORY=.mongodb-data
